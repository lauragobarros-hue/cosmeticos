.catalogo {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 20px;
}

.produto {
    background: #fff0f5;
    border-radius: 15px;
    padding: 15px;
    text-align: center;
}

.produto img {
    width: 100%;
    height: 220px;
    object-fit: contain;
    border-radius: 10px;
}

.produto h3 {
    color: #70263c;
}

.produto p {
    color: #d63384;
    font-weight: bold;
}

.produto button {
    background: #e88da9;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 20px;
    cursor: pointer;
}

.produto button:hover {
    background: #c85d83;
}

@media (max-width: 600px) {
    .catalogo {
        grid-template-columns: repeat(2, 1fr);
    }
}
