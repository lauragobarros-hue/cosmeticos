
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MALJI COSMETIC | Beleza e autocuidado</title>
<meta name="description" content="Conheça os produtos de beleza da MALJI COSMETIC.">

<style>
:root {
  --pink: #d96f91;
  --dark: #a94064;
  --light: #fff0f4;
  --cream: #fffaf7;
  --text: #392a30;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: var(--cream);
  color: var(--text);
  line-height: 1.6;
}

button, input, select {
  font: inherit;
}

button, a {
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}

.topbar {
  background: var(--dark);
  color: white;
  text-align: center;
  padding: 8px;
  font-size: 13px;
}

header {
  background: white;
  padding: 18px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  border-bottom: 1px solid #f0dce3;
}

.logo {
  color: var(--dark);
  font-weight: bold;
  font-size: 25px;
  letter-spacing: 2px;
}

.logo small {
  display: block;
  text-align: center;
  letter-spacing: 5px;
  font-size: 10px;
}

nav {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  font-size: 14px;
}

nav a:hover {
  color: var(--pink);
}

.primary, .cart-button {
  background: var(--pink);
  color: white;
  border: none;
  border-radius: 25px;
  padding: 11px 20px;
  font-weight: bold;
  display: inline-block;
}

.primary:hover, .cart-button:hover {
  background: var(--dark);
}

.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--light);
  align-items: center;
}

.hero-content {
  padding: 50px 10%;
}

.eyebrow {
  color: var(--dark);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 3px;
  text-transform: uppercase;
}

h1 {
  font-family: Georgia, serif;
  font-size: clamp(35px, 4vw, 54px);
  line-height: 1.15;
  margin: 18px 0;
}

.hero-content p {
  color: #796c72;
  margin-bottom: 25px;
}

.hero img {
  width: 100%;
  height: 410px;
  object-fit: cover;
}

section {
  padding: 55px 6%;
}

.heading {
  text-align: center;
  margin-bottom: 30px;
}

.heading h2 {
  font-family: Georgia, serif;
  font-size: 32px;
  margin: 8px 0;
}

.heading p {
  color: #796c72;
  font-size: 14px;
}

.benefits {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.benefit {
  background: white;
  border: 1px solid #f1e2e6;
  border-radius: 12px;
  padding: 22px;
  text-align: center;
}

.benefit p {
  font-size: 13px;
  color: #796c72;
}

.catalog {
  background: white;
}

.toolbar {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 30px;
}

.toolbar input, .toolbar select {
  padding: 12px;
  border: 1px solid #e7cfd8;
  border-radius: 8px;
  min-width: 220px;
  background: white;
}

.products {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
}

.product {
  background: white;
  border: 1px solid #f0e4e8;
  border-radius: 12px;
  overflow: hidden;
  transition: transform .2s, box-shadow .2s;
}

.product:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px #6e344414;
}

.product img {
  display: block;
  width: 100%;
  height: 220px;
  object-fit: cover;
  background: var(--light);
}

.product-info {
  padding: 15px;
}

.category {
  color: var(--dark);
  font-size: 10px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.product h3 {
  font-size: 16px;
  margin: 5px 0;
}

.description {
  color: #796c72;
  font-size: 12px;
  min-height: 38px;
}

.price {
  font-weight: bold;
  font-size: 19px;
  margin: 12px 0;
}

.add {
  width: 100%;
  padding: 10px;
  border: 1px solid #efcad6;
  border-radius: 7px;
  background: var(--light);
  color: var(--dark);
  font-weight: bold;
}

.add:hover {
  background: var(--pink);
  color: white;
}

.empty {
  text-align: center;
  padding: 25px;
  color: #796c72;
  grid-column: 1 / -1;
}

.cart-section {
  background: var(--light);
}

.cart-box {
  max-width: 800px;
  margin: auto;
  padding: 25px;
  background: white;
  border-radius: 12px;
}

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 15px;
  padding: 15px 0;
  border-bottom: 1px solid #f0e4e8;
}

.cart-item small {
  color: #796c72;
}

.quantity {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quantity button, .remove {
  border: 1px solid #edced8;
  border-radius: 6px;
  background: white;
  color: var(--dark);
  padding: 5px 10px;
}

.total {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  font-size: 20px;
  font-weight: bold;
  margin: 24px 0;
}

.note {
  color: #796c72;
  font-size: 12px;
  margin-top: 12px;
}

.about {
  max-width: 750px;
  margin: auto;
  text-align: center;
}

.about p {
  margin-top: 12px;
  color: #796c72;
}

footer {
  text-align: center;
  padding: 30px;
  background: #392a30;
  color: white;
  font-size: 13px;
}

footer p {
  margin-top: 8px;
  color: #e8cbd5;
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .hero img {
    height: 300px;
  }

  .products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  header {
    justify-content: center;
  }

  nav {
    justify-content: center;
  }

  .benefits {
    grid-template-columns: 1fr;
  }

  .products {
    gap: 12px;
  }

  .product img {
    height: 155px;
  }

  .product-info {
    padding: 10px;
  }

  section {
    padding: 38px 5%;
  }
}
</style>
</head>

<body>

<div class="topbar">
  MALJI COSMETIC — sua beleza, seu momento!
</div>

<header>
  <a href="#inicio" class="logo">
    MALJI
    <small>COSMETIC</small>
  </a>

  <nav aria-label="Menu principal">
    <a href="#inicio">Início</a>
    <a href="#produtos">Produtos</a>
    <a href="#sobre">Sobre nós</a>
    <a href="#carrinho">Carrinho</a>
  </nav>

  <button class="cart-button" onclick="irCarrinho()">
    🛍 Carrinho (<span id="count">0</span>)
  </button>
</header>

<main>
  <section class="hero" id="inicio">
    <div class="hero-content">
      <span class="eyebrow">Beleza • Cuidado • Confiança</span>
      <h1>Realce sua beleza, cuide de você.</h1>
      <p>
        Descubra maquiagem e produtos para sua rotina de skincare.
        Seu momento de autocuidado começa aqui.
      </p>
      <a href="#produtos" class="primary">Explorar produtos</a>
    </div>

    <img
      src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=1000&q=85"
      alt="Produtos de beleza e cuidados com a pele"
    >
  </section>

  <section>
    <div class="benefits">
      <div class="benefit">
        <h3>🌷 Beleza para você</h3>
        <p>Produtos para sua rotina de autocuidado.</p>
      </div>
      <div class="benefit">
        <h3>💗 Fácil de encontrar</h3>
        <p>Pesquise e filtre seus cosméticos favoritos.</p>
      </div>
      <div class="benefit">
        <h3>✨ Compra organizada</h3>
        <p>Adicione produtos e calcule o subtotal.</p>
      </div>
    </div>
  </section>

  <section class="catalog" id="produtos">
    <div class="heading">
      <span class="eyebrow">Nossa seleção</span>
      <h2>Produtos em destaque</h2>
      <p>Encontre seus favoritos para sua rotina de beleza.</p>
    </div>

    <div class="toolbar">
      <input
        id="search"
        type="search"
        placeholder="Buscar produto..."
        aria-label="Buscar produto"
      >

      <select id="category" aria-label="Filtrar categoria">
        <option value="todos">Todas as categorias</option>
        <option value="skincare">Skincare</option>
        <option value="maquiagem">Maquiagem</option>
        <option value="acessorios">Acessórios</option>
      </select>
    </div>

    <div class="products" id="products"></div>
  </section>

  <section class="cart-section" id="carrinho">
    <div class="heading">
      <span class="eyebrow">Seus favoritos</span>
      <h2>Carrinho de compras</h2>
      <p>Confira os produtos que você selecionou.</p>
    </div>

    <div class="cart-box">
      <div id="cart-items">
        <p class="empty">Seu carrinho está vazio.</p>
      </div>

      <div class="total">
        <span>Subtotal</span>
        <span id="total">R$ 0,00</span>
      </div>

      <button class="primary" onclick="revisarPedido()">
        Revisar pedido
      </button>

      <p class="note">
        Protótipo demonstrativo. Não processa pagamentos reais.
      </p>
      <p id="message" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section id="sobre">
    <div class="about">
      <span class="eyebrow">Quem somos</span>
      <h2>Sobre a MALJI COSMETIC</h2>
      <p>
        Nossa proposta é oferecer uma experiência simples e organizada
        para conhecer produtos de beleza, maquiagem e cuidados com a pele.
        Este projeto apresenta a primeira versão da loja virtual.
      </p>
    </div>
  </section>
</main>

<footer>
  <strong>MALJI COSMETIC</strong>
  <p>Beleza e autocuidado em um só lugar.</p>
  <p>Protótipo acadêmico — versão inicial.</p>
  <p>© <span id="year"></span> MALJI COSMETIC</p>
</footer>

<script>
const products = [
  {
    id: 1,
    name: "Sérum Facial",
    category: "skincare",
    price: 39.90,
    description: "Cuidado facial para sua rotina diária.",
    image: "https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 2,
    name: "Hidratante Facial",
    category: "skincare",
    price: 34.90,
    description: "Um toque de cuidado para a pele.",
    image: "https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 3,
    name: "Batom Rosa",
    category: "maquiagem",
    price: 19.90,
    description: "Cor e personalidade para seus looks.",
    image: "https://images.unsplash.com/photo-1586495777744-4413f21062fa?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 4,
    name: "Paleta de Maquiagem",
    category: "maquiagem",
    price: 49.90,
    description: "Cores para diferentes produções.",
    image: "https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 5,
    name: "Kit de Pincéis",
    category: "acessorios",
    price: 29.90,
    description: "Acessórios para sua maquiagem.",
    image: "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 6,
    name: "Cuidados com a Pele",
    category: "skincare",
    price: 44.90,
    description: "Complete sua rotina de autocuidado.",
    image: "https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 7,
    name: "Gloss Labial",
    category: "maquiagem",
    price: 17.90,
    description: "Brilho para seus lábios.",
    image: "https://images.unsplash.com/photo-1631214524020-7e18db9a8f92?auto=format&fit=crop&w=600&q=80"
  },
  {
    id: 8,
    name: "Acessórios de Beleza",
    category: "acessorios",
    price: 22.90,
    description: "Pequenos detalhes para sua rotina.",
    image: "https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=600&q=80"
  }
];

const cart = {};

const categoryNames = {
  skincare: "Skincare",
  maquiagem: "Maquiagem",
  acessorios: "Acessórios"
};

function money(value) {
  return value.toLocaleString("pt-BR", {
    style: "currency",
    currency: "BRL"
  });
}

function renderProducts() {
  const query = document.getElementById("search")
    .value.trim().toLocaleLowerCase("pt-BR");
  const category = document.getElementById("category").value;

  const filtered = products.filter(p =>
    p.name.toLocaleLowerCase("pt-BR").includes(query) &&
    (category === "todos" || p.category === category)
  );

  const container = document.getElementById("products");

  if (!filtered.length) {
    container.innerHTML =
      '<p class="empty">Nenhum produto encontrado.</p>';
    return;
  }

  container.innerHTML = filtered.map(p => `
    <article class="product">
      <img
        src="${p.image}"
        alt="${p.name}"
        loading="lazy"
        onerror="this.onerror=null;this.src='https://placehold.co/600x600/fff0f4/a94064?text=Produto';"
      >
      <div class="product-info">
        <span class="category">${categoryNames[p.category]}</span>
        <h3>${p.name}</h3>
        <p class="description">${p.description}</p>
        <p class="price">${money(p.price)}</p>
        <button class="add" onclick="addCart(${p.id})">
          + Adicionar ao carrinho
        </button>
      </div>
    </article>
  `).join("");
}

function addCart(id) {
  cart[id] = (cart[id] || 0) + 1;
  document.getElementById("message").textContent = "";
  renderCart();
}

function changeQuantity(id, amount) {
  if (!cart[id]) return;
  cart[id] += amount;
  if (cart[id] <= 0) delete cart[id];
  renderCart();
}

function removeItem(id) {
  delete cart[id];
  renderCart();
}

function renderCart() {
  const container = document.getElementById("cart-items");
  const entries = Object.entries(cart);
  let quantityTotal = 0;
  let priceTotal = 0;

  if (entries.length === 0) {
    container.innerHTML =
      '<p class="empty">Seu carrinho está vazio.</p>';
  } else {
    container.innerHTML = entries.map(([id, quantity]) => {
      const p = products.find(item => item.id === Number(id));
      quantityTotal += quantity;
      priceTotal += p.price * quantity;

      return `
        <div class="cart-item">
          <div>
            <strong>${p.name}</strong><br>
            <small>${money(p.price)} por unidade</small><br>
            <strong>${money(p.price * quantity)}</strong>
          </div>
          <div class="quantity">
            <button onclick="changeQuantity(${p.id},-1)"
              aria-label="Diminuir quantidade">−</button>
            <span>${quantity}</span>
            <button onclick="changeQuantity(${p.id},1)"
              aria-label="Aumentar quantidade">+</button>
          </div>
          <button class="remove" onclick="removeItem(${p.id})">
            Remover
          </button>
        </div>
      `;
    }).join("");
  }

  document.getElementById("count").textContent = quantityTotal;
  document.getElementById("total").textContent = money(priceTotal);
}

function irCarrinho() {
  document.getElementById("carrinho").scrollIntoView({
    behavior: "smooth"
  });
}

function revisarPedido() {
  const entries = Object.entries(cart);
  const message = document.getElementById("message");

  if (!entries.length) {
    message.textContent = "Adicione um produto antes de continuar.";
    return;
  }

  const total = entries.reduce((sum, [id, qty]) => {
    const p = products.find(item => item.id === Number(id));
    return sum + p.price * qty;
  }, 0);

  message.textContent =
    "Demonstração: subtotal de " + money(total) +
    ". Nenhum pedido real foi enviado.";
}

document.getElementById("search")
  .addEventListener("input", renderProducts);

document.getElementById("category")
  .addEventListener("change", renderProducts);

document.getElementById("year").textContent =
  new Date().getFullYear();

renderProducts();
renderCart();
</script>

</body>
</html>
